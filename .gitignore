node_modules/
dist/
.vite/

# Source panoramas — hundreds of MB, never committed.
raw/

# Generated by `npm run process`, one folder per tour. Rebuildable from the
# sources, destined for object storage rather than git, and deliberately
# outside tours/ so that a bundle never carries hundreds of megabytes.
#
# No trailing slash: on a machine where the panoramas live on other storage
# this is a symlink, not a directory, and `panos/` does not match a symlink.
# It then shows up as untracked on exactly the machines that do the work.
panos

.DS_Store
*.log
